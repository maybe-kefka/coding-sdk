{
  "name": "coding-sdk",
  "version": "0.2.0",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./actions/*": "./src/resources/*.ts",
    "./all": "./src/resources/index.ts",
    "./artifact": "./src/resources/artifact/index.ts",
    "./client": "./src/client/index.ts",
    "./collaboration": "./src/resources/collaboration/index.ts",
    "./continuous-deployment": "./src/resources/continuous-deployment/index.ts",
    "./continuous-integration": "./src/resources/continuous-integration/index.ts",
    "./core": "./src/core/index.ts",
    "./export-job": "./src/resources/export-job/index.ts",
    "./file-storage": "./src/resources/file-storage/index.ts",
    "./git-repository": "./src/resources/git-repository/index.ts",
    "./misc": "./src/resources/misc/index.ts",
    "./organization-and-member": "./src/resources/organization-and-member/index.ts",
    "./permission": "./src/resources/permission/index.ts",
    "./program": "./src/resources/program/index.ts",
    "./project": "./src/resources/project/index.ts",
    "./related-resource": "./src/resources/related-resource/index.ts",
    "./team": "./src/resources/team/index.ts",
    "./service-hook": "./src/resources/service-hook/index.ts",
    "./schemas/*": "./src/resources/*/schemas.ts",
    "./testing": "./src/resources/testing/index.ts",
    "./wiki": "./src/resources/wiki/index.ts",
    "./errors": "./src/core/error/index.ts",
    "./transport": "./src/core/transport/index.ts"
  },
  "module": "src/index.ts",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "typecheck:snapshot": "tsc --noEmit -p tsconfig.snapshot.json"
  },
  "dependencies": {
    "fp-ts": "^2.16.11",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "description": "CODING Open API 的函数式 TypeScript SDK（冻结快照：17 个资源模块、428 个 Action）",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "src",
    "README.md",
    "AGENTS.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maybe-kefka/coding-sdk.git"
  }
}
